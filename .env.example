# Browser API URL. Same-origin /api avoids CORS, mixed-content, and private
# network request restrictions. Docker sets the runtime URL to /api by default.
VITE_API_BASE_URL=/api

# For Vite development, /api is proxied to this backend (default: localhost:8000).
# VITE_DEV_API_TARGET=http://10.0.0.17:8000

# Optional Docker browser-visible runtime override:
# API_BASE_URL=/api
# API_BASE_URL=https://jobtracker-api.example.com
